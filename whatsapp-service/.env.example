# WhatsApp Service configuration
PORT=3001
PYTHON_CORE_URL=http://localhost:8000
# Must match the core API_SECRET_KEY when that is set.
API_SECRET_KEY=
# History backfill on connect. See docs/sync.md for the Web-session limit.
WHATSAPP_HISTORY_ENABLED=true
WHATSAPP_HISTORY_MAX_PER_CHAT=500
WHATSAPP_HISTORY_PAGE_SIZE=100
